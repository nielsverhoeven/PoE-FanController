# Git attributes for PoE FanController
# KiCad files: force LF line endings (Docker CI uses Linux git with core.eol=lf)
*.kicad_sch    text eol=lf
*.kicad_pcb    text eol=lf
*.kicad_pro    text eol=lf
*.kicad_sym    text eol=lf
*.kicad_mod    text eol=lf

# Python
*.py           text eol=lf

# YAML / JSON / Markdown / CSV
*.yml          text eol=lf
*.yaml         text eol=lf
*.json         text eol=lf
*.md           text eol=lf
*.csv          text eol=lf

# C/C++ firmware
*.cpp          text eol=lf
*.h            text eol=lf
*.c            text eol=lf
*.ini          text eol=lf

# Shell scripts
*.sh           text eol=lf

# Windows-specific: keep CRLF for Windows batch files
*.bat          text eol=crlf
*.ps1          text eol=crlf
