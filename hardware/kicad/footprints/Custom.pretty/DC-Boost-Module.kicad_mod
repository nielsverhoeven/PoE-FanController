(footprint "DC-Boost-Module"
  (version 20260206)
  (generator "custom")
  (generator_version "10.0")
  (layer "F.Cu")
  (descr "2x2 corner THT footprint for LM2587 DC-DC Boost Module (Amazon B07RKDB2VP). Board: 48x23mm. Pads at four corners. Pin1=IN+(top-left), Pin2=IN-(bottom-left), Pin3=OUT+(top-right), Pin4=OUT-(bottom-right). Both INs on LEFT side, both OUTs on RIGHT side. Verify pin order against physical unit before soldering (Risk R-03).")
  (tags "dc-dc boost converter module lm2587 4-pin corner tht daughter-board B07RKDB2VP")
  (attr through_hole)

  (fp_text reference "U" (at 0 -14 0) (layer "F.SilkS")
    (effects (font (size 1.27 1.27) (thickness 0.15))))
  (fp_text value "DC-Boost-Module" (at 0 14 0) (layer "F.Fab")
    (effects (font (size 1.27 1.27) (thickness 0.15))))

  (fp_rect (start -24 -11.5) (end 24 11.5)
    (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))

  (fp_rect (start -22 -9.4) (end 22 9.4)
    (stroke (width 0.05) (type solid)) (fill none) (layer "F.CrtYd"))

  ; Pin-1 marker triangle at top-left (IN+)
  (fp_line (start -22.2 -11.5) (end -25.0 -11.5)
    (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -25.0 -11.5) (end -25.0 -8.7)
    (stroke (width 0.12) (type solid)) (layer "F.SilkS"))
  (fp_line (start -22.2 -11.5) (end -25.0 -8.7)
    (stroke (width 0.12) (type solid)) (layer "F.SilkS"))

  (fp_text user "IN+" (at -21 -10.0 0) (layer "F.Fab")
    (effects (font (size 1.0 1.0) (thickness 0.15))))
  (fp_text user "IN-" (at -21 10.0 0) (layer "F.Fab")
    (effects (font (size 1.0 1.0) (thickness 0.15))))
  (fp_text user "OUT+" (at 21 -10.0 0) (layer "F.Fab")
    (effects (font (size 1.0 1.0) (thickness 0.15))))
  (fp_text user "OUT-" (at 21 10.0 0) (layer "F.Fab")
    (effects (font (size 1.0 1.0) (thickness 0.15))))

  ; Pin 1 = IN+   top-left     (-21, -8.5)  rect (pin 1 marker)
  ; Pin 2 = IN-   bottom-left  (-21, +8.5)
  ; Pin 3 = OUT+  top-right    (+21, -8.5)
  ; Pin 4 = OUT-  bottom-right (+21, +8.5)
  ; Both INs on LEFT side, both OUTs on RIGHT side.

  (pad "1" thru_hole rect (at -21 -8.5) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask") (uuid "dc000001-0000-0000-0000-000000000001"))
  (pad "2" thru_hole circle (at -21 8.5) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask") (uuid "dc000002-0000-0000-0000-000000000002"))
  (pad "3" thru_hole circle (at 21 -8.5) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask") (uuid "dc000003-0000-0000-0000-000000000003"))
  (pad "4" thru_hole circle (at 21 8.5) (size 1.8 1.8) (drill 1.0) (layers "*.Cu" "*.Mask") (uuid "dc000004-0000-0000-0000-000000000004"))
)