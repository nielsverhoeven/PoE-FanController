        (clearance 0.3)
        (track_width 1.0)
        (diff_pair_width 0.5)
        (diff_pair_gap 0.25)
        (diff_pair_via_gap 0.25)
        (via_diameter 1.2)
        (via_drill 0.6)
        (uvia_diameter 0.3)
        (uvia_drill 0.1))
      (class
        (name "PoE_Isolation")
        (clearance 3.5)
        (track_width 1.0)
        (diff_pair_width 0.5)
        (diff_pair_gap 0.25)
        (diff_pair_via_gap 0.25)
        (via_diameter 1.2)
        (via_drill 0.6)
        (uvia_diameter 0.3)
        (uvia_drill 0.1))
    )
    (netclass_patterns
      (netclass_pattern (pattern "POE*") (netclass "PoE_Isolation"))
      (netclass_pattern (pattern "+12V") (netclass "Power"))
      (netclass_pattern (pattern "GND")  (netclass "Power"))
      (netclass_pattern (pattern "+3V3") (netclass "Power"))))
