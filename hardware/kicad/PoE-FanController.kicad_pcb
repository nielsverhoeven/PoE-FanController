  (net 4 "POE_A+")
  (net 5 "POE_A-")
  (net 6 "POE_B+")
  (net 7 "POE_B-")
  (net 8 "FAN1_PWM")
  (net 9 "FAN2_PWM")
  (net 10 "FAN3_PWM")
  (net 11 "FAN4_PWM")
  (net 12 "FAN1_TACH")
  (net 13 "FAN2_TACH")
  (net 14 "FAN3_TACH")
  (net 15 "FAN4_TACH")
  (net 16 "ESP_TX")
  (net 17 "ESP_RX")
  (net 18 "EN")
  (net 19 "BOOT")
  (net 20 "USB_DP")
  (net 21 "USB_DN")
  (net 22 "VBUS")
  (net 23 "GPIO32")
  (net 24 "NTC_MID")
  (net_settings
    (classes
      (class
        (name "Default")
        (clearance 0.2)
        (track_width 0.25)
        (diff_pair_width 0.2)
        (diff_pair_gap 0.25)
        (diff_pair_via_gap 0.25)
